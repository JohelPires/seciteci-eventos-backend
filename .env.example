# Aplicacao
PORT=3030
NODE_ENV=development
# Qual ambiente publicado esta API e, com NODE_ENV=production
# (producao | homologacao | desenvolvimento; ausente = producao, o mais duro).
# Homologacao/desenvolvimento publicados usam a chave sk_test_ do Clerk.
AMBIENTE=desenvolvimento

# Clerk (login): padrao fic_dev/padroes-servicos/clerk.md
CLERK_SECRET_KEY=sk_test_...
# PEM da JWT public key (API keys -> JWT public key); vazia = busca via rede
CLERK_JWT_KEY=
# Origem(ns) do painel, separada(s) por virgula (claim azp do token)
CLERK_AUTHORIZED_PARTIES=https://host-do-painel
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# E-mail do admin usado pelo seed (obrigatorio para npm run prisma:seed)
ADMIN_EMAIL=admin@eventos.com

# Banco (usado quando rodando sem Docker; no Docker o compose define)
# DATABASE_URL=postgresql://usuario:senha@host:5432/sistema_eventos

# E-mail (Plunk). O remetente precisa usar um dominio verificado no projeto.
EMAIL_ENABLED=false
EMAIL_FROM=Seciteci Eventos <nao-responder@conectese.secitec.mt.gov.br>
PLUNK_API_URL=https://next-api.useplunk.com
PLUNK_SECRET_KEY=sk_...
